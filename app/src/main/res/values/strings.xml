<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">My Habit App</string>

    <!--
      The Notion connection wizard (M4.12).

      Two rules govern every string below. Nothing names a Notion property — CLAUDE.md §3.4 makes
      the schema user data, so "Date" and "📖 Read" appear only because Notion said so at runtime.
      And every failure line names the fix rather than the fault: the user cannot act on "404".
    -->
    <string name="setup_step_counter">Step %1$d of %2$d</string>
    <string name="setup_back">Back</string>

    <!-- Step 1 — the token -->
    <string name="setup_token_title">Connect to Notion</string>
    <string name="setup_token_body">Your habits live in a Notion database. Paste a token so this app can read and update it.</string>
    <string name="setup_token_label">NOTION TOKEN</string>
    <string name="setup_token_placeholder">ntn_…</string>
    <!--
      The wording of this path was confirmed against the live docs in M4.1 (docs/notion-api.md §3).
      Notion renamed "internal integration" to "personal access token" and "integrations" to
      "connections" — sending the user to look for the old names sends them looking for nothing.
    -->
    <string name="setup_token_helper">In Notion: Developer portal → Personal access tokens → New token. Notion shows it once, so copy it before closing.</string>
    <string name="setup_token_continue">Continue</string>

    <!-- Step 2 — which database -->
    <string name="setup_database_title">Pick your habit database</string>
    <string name="setup_database_body">These are the databases your token can reach.</string>
    <string name="setup_database_untitled">Untitled database</string>
    <string name="setup_database_continue">Continue</string>
    <string name="setup_database_use_link">Don\'t see it? Paste a link instead</string>
    <string name="setup_link_label">DATABASE LINK</string>
    <string name="setup_link_placeholder">https://www.notion.so/…</string>
    <string name="setup_link_helper">In Notion: open the database → ••• → Copy link.</string>
    <string name="setup_link_submit">Find it</string>
    <string name="setup_link_unreadable">That doesn\'t look like a Notion link. Copy the database\'s link from Notion and paste the whole thing.</string>

    <!-- Step 3 — the mapping -->
    <string name="setup_mapping_title">Which columns are what?</string>
    <string name="setup_mapping_body">In this database each page is one day, and each habit is a checkbox on it.</string>
    <string name="setup_mapping_day_eyebrow">WHICH COLUMN IS THE DAY?</string>
    <string name="setup_mapping_day_empty">This database has no date column, so there is no way to tell which day a page is. Add one in Notion, then come back.</string>
    <string name="setup_mapping_habits_eyebrow">WHICH COLUMNS ARE HABITS?</string>
    <string name="setup_mapping_habits_empty">This database has no checkbox columns, so there are no habits to import.</string>
    <string name="setup_mapping_unavailable_eyebrow">NOT AVAILABLE</string>
    <!--
      docs/notion-schema.md §7: Weight, Sleep, Area and Progress share the database and must come
      through a sync untouched. Saying so is what stops "where is my Progress column?" being a bug
      report. CLAUDE.md §3.2 wants the UI to PREVENT a read-only property being picked — these are
      shown, and not selectable.
    -->
    <string name="setup_mapping_unavailable_body">These aren\'t dates or checkboxes, so they can\'t be a day or a habit. Sync leaves them exactly as they are.</string>
    <string name="setup_mapping_submit">Save and import</string>
    <string name="setup_mapping_needs_habit">Pick at least one habit.</string>
    <!--
      M7.8, and the user's decision on 2026-08-31: named, and shown only when the current selection
      actually drops a habit that is mapped now. Silent on a first map and silent while you are only
      adding — it never warns about a habit you did not just untick. %1$s is the habit or habits,
      already joined.
    -->
    <plurals name="setup_mapping_dropping">
        <item quantity="one">%1$s will stop syncing and leave your habit list. Its history stays on this phone and comes back if you tick it again.</item>
        <item quantity="other">%1$s will stop syncing and leave your habit list. Their history stays on this phone and comes back if you tick them again.</item>
    </plurals>
    <string name="setup_mapping_dropping_join">%1$s and %2$s</string>
    <string name="setup_mapping_dropping_join_more">%1$s, %2$s</string>
    <string name="setup_mapping_reload">Try again</string>

    <!-- Done -->
    <string name="setup_done_title">Connected</string>
    <plurals name="setup_done_body">
        <item quantity="one">%1$d day imported from Notion.</item>
        <item quantity="other">%1$d days imported from Notion.</item>
    </plurals>
    <string name="setup_done_body_empty">No days to import yet. Check a habit off and it will appear in Notion.</string>

    <!--
      The sync-status screen (M4.13). CLAUDE.md §3.5: failure is "a clear, non-blocking,
      human-readable message with a retry affordance" — never a modal over the check-off loop.
    -->
    <string name="sync_title">Notion sync</string>
    <string name="sync_connected">Connected to Notion</string>
    <string name="sync_not_connected">Not connected</string>
    <string name="sync_not_connected_body">Connect a Notion database to start syncing your habits.</string>
    <string name="sync_in_progress">Syncing…</string>
    <string name="sync_never">Never synced</string>
    <string name="sync_just_now">Last synced just now</string>
    <plurals name="sync_minutes_ago">
        <item quantity="one">Last synced %1$d minute ago</item>
        <item quantity="other">Last synced %1$d minutes ago</item>
    </plurals>
    <plurals name="sync_hours_ago">
        <item quantity="one">Last synced %1$d hour ago</item>
        <item quantity="other">Last synced %1$d hours ago</item>
    </plurals>
    <plurals name="sync_days_ago">
        <item quantity="one">Last synced %1$d day ago</item>
        <item quantity="other">Last synced %1$d days ago</item>
    </plurals>
    <!--
      ⭐ M4.16. The user chose these words on 2026-08-25 (ADR-057) over "Waiting for a connection"
      and "Offline — your changes are saved": it leads with what happens next rather than with the
      problem, which is the honest emphasis for a run WorkManager is already holding.
      Deliberately NOT sync_failure_offline's "check your connection and try again" — there is
      nothing here for the user to retry.
    -->
    <string name="sync_waiting_for_network">Will sync when you\'re back online</string>
    <string name="sync_retry">Sync now</string>

    <!--
      ⭐ The notices CLAUDE.md §3.5 requires: "Where resolution discards a user's edit, say so in
      the UI. Never resolve destructively and silently." Both sides are the same person in this
      app, which is why the two sentences differ — the user is entitled to know which happened.
    -->
    <string name="sync_discarded_eyebrow">CHANGES THAT WERE REPLACED</string>
    <string name="sync_discarded_body">Two copies of a day disagreed, so the newer one won. Here is what the older one said.</string>
    <string name="sync_discarded_local">%1$s — your change on this phone was replaced by your later change in Notion.</string>
    <string name="sync_discarded_remote">%1$s — your change in Notion was replaced by your later change on this phone.</string>
    <plurals name="sync_discarded_habits">
        <item quantity="one">%1$d habit affected</item>
        <item quantity="other">%1$d habits affected</item>
    </plurals>
    <string name="sync_discarded_dismiss">Got it</string>

    <!--
      Disconnect. CLAUDE.md §3.6 requires it, and requires wiping the local data to be the user's
      SEPARATE choice — for a habit whose Notion column was since deleted, the local copy may be
      the only one left (docs/notion-schema.md §4.1).
    -->
    <string name="sync_disconnect">Disconnect from Notion</string>
    <string name="sync_disconnect_title">Disconnect from Notion?</string>
    <string name="sync_disconnect_body">Your token and database setup will be removed from this phone. Nothing in Notion is changed or deleted.</string>
    <string name="sync_disconnect_delete_local">Also delete the habits and history stored on this phone</string>
    <string name="sync_disconnect_delete_local_warning">This cannot be undone. If a habit\'s column was deleted in Notion, this phone may hold the only copy of its history.</string>
    <string name="sync_disconnect_confirm">Disconnect</string>
    <string name="sync_disconnect_cancel">Cancel</string>

    <!--
      Failure sentences — one per SyncFailure case, rendered by NotionFailureBanner.
      ⭐ NOT prefixed `setup_`, and that matters: BOTH the connection wizard and the sync-status
      screen show these, and two screens calling the same 401 different things is exactly what one
      shared list prevents. The `when` that picks between them is exhaustive, so adding a way to
      fail makes the compiler point here.
    -->
    <string name="notion_failure_not_connected">No token is stored. Paste one to continue.</string>
    <string name="notion_failure_token_rejected">Notion wouldn\'t accept that token. Check you copied all of it, or create a new one.</string>
    <string name="notion_failure_missing_capability">That token isn\'t allowed to do this. In Notion, give the connection permission to read and update content.</string>
    <!--
      ⭐ CLAUDE.md §3.3 and docs/notion-api.md §3.1. Notion returns the same 404 for "doesn't exist"
      and "not shared with the connection", and gives no way to tell them apart. Sharing is the fix
      far more often, so that is the instruction — never "not found".
    -->
    <string name="notion_failure_database_not_shared">No database is shared with this connection yet. In Notion, open your habit database → ••• (top right) → Connections → add your connection, then try again.</string>
    <string name="notion_failure_mapping_broken">Your database has changed since it was set up.</string>
    <string name="notion_failure_offline">Couldn\'t reach Notion. Check your connection and try again.</string>
    <string name="notion_failure_notion_unavailable">Notion is busy or having trouble. Try again in a moment.</string>
    <string name="notion_failure_app_out_of_date">This app and Notion disagree about something. There\'s nothing to fix here — the app needs updating.</string>

    <!-- Mapping problems, listed under setup_failure_mapping_broken. -->
    <string name="notion_issue_day_key_missing">The day column was deleted.</string>
    <string name="notion_issue_day_key_retyped">The day column is now a %1$s.</string>
    <string name="notion_issue_habit_missing">A habit column was deleted.</string>
    <string name="notion_issue_habit_retyped">“%1$s” is now a %2$s.</string>
    <string name="notion_issue_wrong_data_source">The saved setup points at a different database.</string>
    <!--
      Bottom-nav labels — docs/design-spec.md §1. One word each, because the bar gives them 10sp
      across a fifth of the screen; anything longer wraps or ellipsises on a narrow device.
    -->
    <string name="tab_month">Month</string>
    <string name="tab_week">Week</string>
    <string name="tab_year">Year</string>
    <string name="tab_stats">Stats</string>
    <string name="tab_settings">Settings</string>

    <!--
      Scaffolding, and M7 replaces it with the real Settings screen. It exists because deleting
      HabitsAppRoot in M5.2 took away the only route into sync status, and the user asked that the
      screen keep a way in rather than going dark until M7.
    -->
    <string name="settings_notion_sync">Notion sync</string>

    <!--
      The way into the habit list (M7.5). It is a Settings row rather than a glyph on the Week
      header — the user's choice: this screen is reference plus one preference, not a per-week
      action, and M7.8's route back to the mapping links from the same place.

      The design's header `+` is NOT that glyph and never will be: ADR-010 makes a habit a column in
      the user's Notion database, so there is nothing this app can create.
    -->
    <string name="settings_habits">Your habits</string>

    <!--
      Header titles — docs/design-spec.md §1. Deliberately NOT the same strings as the tab labels:
      the design's header reads "Statistics" where the tab reads "Stats", and the Month header will
      eventually read the month's name rather than "Month" at all (M8).
    -->
    <string name="screen_title_month">Month</string>
    <string name="screen_title_week">Week</string>
    <string name="screen_title_year">Year</string>
    <string name="screen_title_stats">Statistics</string>
    <string name="screen_title_settings">Settings</string>
    <!--
      "Your habits", not "Habits" — the user's choice on 2026-08-30, over "Habits" and
      "Habits &amp; colours". The screen appears in no Figma frame (docs/design-spec.md §0), so the
      name was theirs to settle rather than inherited from M5.3's stub.
    -->
    <string name="screen_title_habits">Your habits</string>

    <!--
      Scaffolding (M5.3). Every screen showing this is replaced by the milestone that builds it, and
      this string goes with the last of them. It exists because a destination that renders nothing
      is indistinguishable from one that is broken — M5.6 asks the user to click through the shell.
    -->
    <string name="stub_placeholder">Nothing here yet — this screen is built in a later milestone.</string>

    <!--
      Week view (M6.3) — docs/design-spec.md §3.

      week_card_summary fills the card's second line. The design calls that line a "description"
      and shows "15 min practice", but ADR-027 deleted Habit.description: Notion has nowhere to
      keep one and ADR-010 makes the habit set read-only, so there is no source for it. The slot is
      drawn unconditionally, so leaving it blank holds the space and reads like a failed load —
      this puts the most useful fact a week view has there instead. UNDESIGNED; see Plan.md M6.11.

      week_empty_* is M6.8's, and the copy is UNDESIGNED - the user judges it at M6.11 with the
      rest of M6's wording.

      There is no "add a habit" call to action and there never will be: ADR-010 removed habit
      creation, because a habit IS a checkbox property in the user's Notion database.

      Two sentences, not one, and the reason is ADR-072. The only thing that empties this screen is
      an import that has not landed - and every first-run user sees it, because the setup wizard
      saves the mapping (which flips the shell's gate) BEFORE it awaits the first sync. If that sync
      then fails, the wizard holding the error is already off screen, so this is the only surface
      left to say so. Hence: on its way, or it failed and here is where to look.

      The failure REASON is deliberately absent. SyncStatusScreen renders every SyncFailure with the
      sentence and the retry that belong to it; a second rendering here would be two places to keep
      in step.
    -->
    <string name="week_card_summary">%1$d of %2$d</string>
    <string name="week_previous">Previous week</string>
    <string name="week_next">Next week</string>
    <string name="week_this_week">This week</string>
    <string name="week_pill_description">%1$s, %2$s</string>
    <string name="week_empty_pending_emoji">☑️</string>
    <string name="week_empty_pending_title">Your habits are on their way</string>
    <string name="week_empty_pending_body">They come from the checkbox columns in your Notion database, and appear here as soon as the first sync finishes.</string>
    <string name="week_empty_failed_emoji">⚠️</string>
    <string name="week_empty_failed_title">Your habits haven\'t arrived</string>
    <string name="week_empty_failed_body">The last sync didn\'t finish, so there is nothing to show yet. Notion sync has the reason and a way to try again.</string>
    <string name="week_empty_failed_action">Open Notion sync</string>

    <!--
      The manage-habits screen (M7.5). UNDESIGNED — the prototype has no such screen at all.

      Two facts do all the work here, and both are ADR-010's: a habit IS a checkbox column in the
      user's Notion database, and the colour is the one thing that is ours. So the copy says where
      the name and the history live, and says that the colour does not go there. There is no "add a
      habit" call to action and there never will be.

      ⚠ What this copy deliberately does NOT promise: that a column added in Notion becomes a
      habit. It does not — only the saved mapping decides (M7.4/ADR-079), because Weight, Sleep,
      Area and Progress share the same database. M7.8 builds the route that adopts a new column and
      owns the sentence that describes it.

      habits_notion_pending is the disabled button's helper. It leads with what happens next rather
      than with what is missing, which is the wording the user chose for sync_waiting_for_network.
    -->
    <string name="habits_body">Each of these is a checkbox column in your Notion database, so its name and its history live there.</string>
    <string name="habits_colour_body">Tap a colour to change how a habit looks in this app. Colours stay on this phone — Notion never sees them.</string>
    <string name="habits_open_in_notion">Open in Notion</string>
    <string name="habits_notion_pending">Available after the next sync.</string>
    <string name="habits_empty">No habits yet. They arrive from Notion with the first sync.</string>
    <!--
      M7.8's sentence, which ADR-079 said this screen owed and could not yet say: a new checkbox
      column is not a habit until the mapping names it, because Weight, Sleep, Area and Progress
      live in the same database (docs/notion-schema.md §4.3).
    -->
    <string name="habits_mapping_body">Added a column in Notion? It becomes a habit once you pick it here. Columns like Weight and Sleep stay out of the way.</string>
    <string name="mapping_edit_action">Choose which columns are habits</string>
    <string name="habits_colour_blue">Blue</string>
    <string name="habits_colour_green">Green</string>
    <string name="habits_colour_orange">Orange</string>
    <string name="habits_colour_purple">Purple</string>

    <!--
      Undo snackbar (M6.6) — UNDESIGNED. The prototype has no snackbar because it has no click
      handlers at all (docs/design-spec.md §0), so this copy is ours. The user read it at M6.11 and
      kept the wording; what they changed was WHEN it fires, not what it says.

      The sentence names the HABIT and the DAY on purpose. The flipped pill already says that
      something happened; what it cannot say is that the tap landed on Thursday when Wednesday was
      meant, or on Reading when Running was — the two mistakes seven 44dp pills across five stacked
      cards actually invite. Naming both is the whole reason the message exists; "Done" or "Saved"
      would be the nagging-about-a-normal-condition this feature is already at risk of.

      There is no "today" variant any more, and the absence is the decision: M6.11 made a tap on
      today SILENT, so %2$s is always a real date. A "today" string would be a resource nothing can
      reach. See WeekViewModel.habitToAnnounce.
    -->
    <string name="week_undo_checked">%1$s checked off for %2$s</string>
    <string name="week_undo_cleared">%1$s cleared for %2$s</string>
    <string name="week_undo_action">Undo</string>
</resources>
