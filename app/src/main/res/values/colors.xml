<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The one colour that cannot live in Color.kt.

      A window background is painted by the platform before any Compose frame exists, so it has to
      be an XML resource. Without it the window inherits the platform parent's #303030, which flashes
      a lighter grey on cold start and shows behind the app in the recents snapshot.

      This MUST equal HabitsDarkColorScheme.background. ThemeTest asserts exactly that, so the two
      cannot drift apart silently.
    -->
    <color name="window_background">#FF111113</color>

    <!--
      The launcher icon's two colours. Same problem as above: a resource XML cannot read Color.kt.

      The background is an alias, not a second copy of the hex — the icon's ground IS the app's
      background, and aliasing means it cannot drift from window_background or from Compose.

      The accent has to be a literal, because Primary lives only in Kotlin. ThemeTest asserts it
      equals HabitsDarkColorScheme.primary, so if the palette ever moves, a test fails rather than
      the launcher quietly showing last season's blue.
    -->
    <color name="ic_launcher_background">@color/window_background</color>
    <color name="ic_launcher_accent">#FF4A9EFF</color>
</resources>
