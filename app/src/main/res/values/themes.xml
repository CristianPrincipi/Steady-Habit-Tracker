<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A deliberately minimal launch theme. The app's real theme is Compose-side —
      HabitsTheme, built in M2.4 — and this exists only so the window has the right
      background before the first Compose frame. It uses a platform parent so that no new
      dependency is pulled in for XML theming. v1 is dark-only (ADR-009), hence the dark parent.

      windowBackground is set explicitly because the platform parent's own is #303030, which
      flashes a lighter grey on cold start and shows behind the app in the recents snapshot.
      @color/window_background mirrors HabitsDarkColorScheme.background; ThemeTest asserts they
      are equal so they cannot drift apart.
    -->
    <style name="Theme.Steady" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      M16.3: TodayReadingActivity's window, which holds nothing but a dialog. Transparent and
      translucent so the home screen it was opened from stays in view behind the dialog's own scrim,
      and no opening animation, so the dialog appears where the tap was rather than after a slide.
    -->
    <style name="Theme.Steady.Translucent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
