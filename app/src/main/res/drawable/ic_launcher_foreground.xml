<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher mark: "the stream" — four cells that lengthen and gain weight across a row.

  It replaces the 3x3 dot grid that stood here from M2 until M14.1. That mark was invented because
  the Figma prototype designs no icon; this one comes from the final identity the user delivered as
  a design (`Steady.dc.html`, Sept 2026), where it is drawn from the Week strip — so the identity is
  still the interface at 48dp rather than a picture placed on top of it, which is the property the
  old mark had and the reason the replacement keeps the same principle.

  It reads as flow: a beginning, a direction, an end. Four beats accelerating into one long hold.

  THE SAFE ZONE IS A CIRCLE, NOT A SQUARE. An adaptive icon is 108x108 with an inner 66x66
  nominally guaranteed, but a launcher may mask it to a circle, so the real guarantee is a 66dp
  DIAMETER circle — radius 33 from (54,54). This mark spans 62dp horizontally and 12dp vertically,
  a 63.15dp diagonal, which puts its corners 31.58 from the centre: 1.42dp of margin.

  That is deliberately tight. The mark is meant to run nearly the full width of the tile, and the
  design's own geometry table says so ("62dp - 63dp diag - fits"). A circular mask is where to
  check it, not a square one.

  The path data below was COMPUTED from six numbers, not drawn:

      y 48 - height 12 - corner 2.5 - x 23 / 32 / 45 / 63 - width 5 / 9 / 14 / 22

  To change the mark, recompute from those rather than nudging coordinates by eye. Each cell is the
  same rounded-rectangle formula; the first one's `H25.5` is a zero-length top edge, because a width
  of 5 with a corner of 2.5 rounds that cell into a vertical capsule. It is left in so the formula
  stays visible across all four.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The fade is doing work the geometry cannot at this scale: 30 / 52 / 76 / 100% is what turns
      four bars into an acceleration. Each cell needs its own path because fillAlpha is per-path.
    -->
    <path
        android:fillAlpha="0.3"
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M25.5,48 H25.5 A2.5,2.5 0 0 1 28,50.5 V57.5 A2.5,2.5 0 0 1 25.5,60 H25.5 A2.5,2.5 0 0 1 23,57.5 V50.5 A2.5,2.5 0 0 1 25.5,48 Z" />

    <path
        android:fillAlpha="0.52"
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M34.5,48 H38.5 A2.5,2.5 0 0 1 41,50.5 V57.5 A2.5,2.5 0 0 1 38.5,60 H34.5 A2.5,2.5 0 0 1 32,57.5 V50.5 A2.5,2.5 0 0 1 34.5,48 Z" />

    <path
        android:fillAlpha="0.76"
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M47.5,48 H56.5 A2.5,2.5 0 0 1 59,50.5 V57.5 A2.5,2.5 0 0 1 56.5,60 H47.5 A2.5,2.5 0 0 1 45,57.5 V50.5 A2.5,2.5 0 0 1 47.5,48 Z" />

    <!-- The hold. The only cell at full weight, and the one the eye lands on. -->
    <path
        android:fillColor="@color/ic_launcher_mark"
        android:pathData="M65.5,48 H82.5 A2.5,2.5 0 0 1 85,50.5 V57.5 A2.5,2.5 0 0 1 82.5,60 H65.5 A2.5,2.5 0 0 1 63,57.5 V50.5 A2.5,2.5 0 0 1 65.5,48 Z" />

</vector>
