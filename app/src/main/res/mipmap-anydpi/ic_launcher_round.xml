<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately identical to ic_launcher.

  android:roundIcon predates adaptive icons: it let an app ship a second, pre-circled raster for
  launchers that wanted round icons. An adaptive icon already hands the launcher separate layers
  to mask however it likes, so a distinct round variant would be the same drawing twice. The
  manifest still points roundIcon here, because a launcher that asks for it should get the icon
  rather than nothing.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
