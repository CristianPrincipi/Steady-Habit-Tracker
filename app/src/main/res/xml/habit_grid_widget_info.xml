<?xml version="1.0" encoding="utf-8"?>
<!--
  The "Habit grid" entry in the widget picker - M15.6b.

  targetCellWidth/Height are the API 31+ way to say "four cells by two", which is the reference's
  large footprint; minWidth/minHeight are the pre-31 fallback and must stay in agreement with them.
  minResizeWidth is the SMALL size from HabitGridWidget, so the user can drag it down to the
  reference's square shape and no further - below two cells the header has nowhere to go.

  resizeMode is horizontal only. Vertical resizing would leave empty space under a grid whose
  height is fixed at seven rows by definition, so offering it would promise something the design
  cannot use.

  initialLayout is Glance's own loading layout - what shows in the instant between the widget being
  dropped and provideGlance returning.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.cristianprincipi.habits.feature.widget.HabitWidgetConfigActivity"
    android:description="@string/widget_habit_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="120dp"
    android:minResizeWidth="160dp"
    android:minWidth="320dp"
    android:resizeMode="horizontal"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:widgetCategory="home_screen" />
