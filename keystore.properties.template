# Template for keystore.properties — M14.4.
#
# COPY this file to `keystore.properties` (same directory, no `.template`) and fill in the four
# values. This template is committed and holds no secrets; `keystore.properties` is gitignored and
# must never be committed, pasted into an issue, or screenshotted.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# Creating the keystore — you do this once, and you keep it forever.
#
#   keytool -genkeypair -v \
#     -keystore steady-release.jks \
#     -storetype PKCS12 \
#     -alias steady \
#     -keyalg RSA -keysize 2048 \
#     -validity 10000
#
# `keytool` ships with any JDK. On this machine:
#   "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe"
#
# It will ask for a keystore password, then for the certificate fields (name, organisation,
# city, country code). The certificate fields are cosmetic for Play — they are not verified —
# but they cannot be changed afterwards, so put something you are willing to keep.
#
# ⚠ KEEP THE FILE OUTSIDE THIS REPOSITORY. A path like C:/Users/you/keystores/ is fine.
#   Inside the repo it is one `git add -f` away from being public forever.
#
# ⚠⚠ BACK IT UP, AND BACK UP THE PASSWORDS WITH IT. Google Play binds a package name to its
#   signing key permanently. Without Play App Signing, losing this file means you can never
#   publish an update to com.cristianprincipi.habits again — the only route is a new package
#   name, which is a new listing with no installs, no reviews and no users carried over.
#
# ⭐ ENROL IN PLAY APP SIGNING when you first upload. Google then holds the app signing key and
#   this keystore becomes your *upload* key — and an upload key can be reset by contacting them
#   if it is ever lost. It turns the paragraph above from unrecoverable into inconvenient.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Absolute path to the keystore. Use forward slashes even on Windows — a backslash is an escape
# character in a .properties file, so C:\Users\... silently becomes C:Users...
storeFile=C:/Users/you/keystores/steady-release.jks

# The password you gave the keystore itself.
storePassword=

# The -alias you passed to keytool. `steady` in the command above.
keyAlias=steady

# The password for that key. keytool offers to reuse the store password; if you accepted, these
# two are the same value.
keyPassword=
