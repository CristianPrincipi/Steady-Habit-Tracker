# --- Secrets: never commit any of these ---
local.properties
keystore.properties
secrets.properties
*.jks
*.keystore
# The Notion token is stored encrypted on-device and must never reach the repo.

# --- Gradle / build output ---
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
*.log
# Android Studio's "Generate Signed App Bundle / APK" output. Anchored on purpose: a bare `release/`
# would also swallow `app/src/release/`, where the Baseline Profile is generated and committed.
/app/release/

# The Gradle wrapper jar stays tracked.
!gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.kotlin/
.navigation/
.vscode/

# --- Local tooling ---
.claude/
.mcp.json

# --- OS ---
.DS_Store
Thumbs.db
